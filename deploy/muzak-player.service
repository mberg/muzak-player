[Unit]
Description=Muzak player
# Start as soon as sound is ready, without waiting for Wi-Fi: the player shows the saved
# library straight away and connects to Spotify once the network is up.
After=sound.target bluetooth.target bluealsa.service
Wants=bluealsa.service

[Service]
User=muzak
Group=muzak
SupplementaryGroups=video input audio render bluetooth
Environment=SLINT_BACKEND=linuxkms-femtovg
Environment=RUST_LOG=info,librespot=warn
ExecStart=/usr/local/bin/muzak-player --config /etc/muzak/config.toml
UMask=0077
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
