[Unit]
Description=Ziggy player
# Start as soon as sound is ready, without waiting for Wi-Fi: the player shows the saved
# library straight away and connects to Spotify once the network is up.
After=sound.target bluetooth.target

[Service]
User=ziggy-player
Group=ziggy-player
SupplementaryGroups=video input audio render bluetooth
Environment=SLINT_BACKEND=linuxkms-femtovg
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/ziggy-player --config /etc/ziggy/config.toml
UMask=0077
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
