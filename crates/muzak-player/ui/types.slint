export struct TileData {
    uri: string,
    title: string,
    subtitle: string,
    image: image,
    has-image: bool,
}

export struct TrackData {
    uri: string,
    title: string,
    artists: string,
    duration: string,
    current: bool,
}

export enum ScreenKind { grid, detail, now-playing, search, artist, settings }

export struct SpeakerRowData {
    address: string,
    name: string,
    status: string,
}

export enum LoadState { loading, empty, failed, forbidden, limited, ready }

// kind: 0 header, 1 song, 2 album, 3 artist, 4 playlist.
export struct SearchRowData {
    kind: int,
    title: string,
    subtitle: string,
    image: image,
    has-image: bool,
    uri: string,
}
