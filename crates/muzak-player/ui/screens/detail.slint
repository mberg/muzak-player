import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { TileData, TrackData, LoadState } from "../types.slint";
import { IconButton } from "../components/icon_button.slint";
import { PillButton } from "../components/pill_button.slint";
import { TrackRow } from "../components/track_row.slint";
import { StateMessage } from "../components/state_message.slint";

export component DetailScreen inherits Rectangle {
    in property <TileData> header;
    in property <[TrackData]> tracks;
    in property <LoadState> state;
    // The signed-in account owns this playlist.
    in property <bool> editable;
    in property <bool> editing;
    callback back();
    callback play(bool);
    callback play-track(int);
    callback add(string);
    callback edit();
    callback finish-editing();
    callback rename();
    callback delete();
    callback remove(int);
    callback move-track(int, int);
    // Drag state: which row is held, and how far it has moved.
    property <int> drag-from: -1;
    property <length> drag-dy: 0px;
    property <int> drag-to: root.drag-from < 0 ? -1
        : Math.max(0, Math.min(root.tracks.length - 1, root.drag-from + Math.round(root.drag-dy / Theme.touch)));
    background: Theme.bg;
    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        VerticalLayout {
            width: 240px;
            spacing: 10px;
            alignment: start;
            HorizontalLayout {
                IconButton {
                    icon: @image-url("../icons/back.svg");
                    clicked => { root.back(); }
                }
                Rectangle {}
                if root.editable && !root.editing: IconButton {
                    icon: @image-url("../icons/edit.svg");
                    clicked => { root.edit(); }
                }
            }
            Rectangle {
                width: 180px;
                height: 180px;
                border-radius: Theme.radius;
                clip: true;
                background: Theme.surface;
                Image {
                    source: @image-url("../icons/note.svg");
                    width: 40%;
                    height: 40%;
                    colorize: Theme.text-dim;
                    visible: !root.header.has-image;
                }
                Image {
                    width: 100%;
                    height: 100%;
                    source: root.header.image;
                    image-fit: cover;
                    opacity: root.header.has-image ? 1 : 0;
                    animate opacity { duration: 200ms; }
                }
            }
            Text {
                text: root.header.title;
                color: Theme.text;
                font-size: 22px;
                font-weight: 800;
                wrap: word-wrap;
                overflow: elide;
                max-height: 60px;
            }
            if !root.editing: HorizontalLayout {
                spacing: 10px;
                alignment: start;
                PillButton {
                    label: "Play";
                    icon: @image-url("../icons/play.svg");
                    primary: true;
                    clicked => { root.play(false); }
                }
                IconButton {
                    icon: @image-url("../icons/shuffle.svg");
                    clicked => { root.play(true); }
                }
            }
            if root.editing: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                IconButton {
                    size: 52px;
                    icon: @image-url("../icons/edit.svg");
                    clicked => { root.rename(); }
                }
                IconButton {
                    size: 52px;
                    icon: @image-url("../icons/delete.svg");
                    clicked => { root.delete(); }
                }
                PillButton {
                    min-width: 96px;
                    label: "Done";
                    primary: true;
                    clicked => { root.finish-editing(); }
                }
            }
        }
        Rectangle {
            ListView {
                for track[i] in root.tracks: TrackRow {
                    data: track;
                    editing: root.editing;
                    drag-offset: i == root.drag-from ? root.drag-dy : 0px;
                    drop-marker: i != root.drag-to || i == root.drag-from ? 0 : (root.drag-to < root.drag-from ? 1 : 2);
                    clicked => { root.play-track(i); }
                    add => { root.add(track.uri); }
                    remove => { root.remove(i); }
                    drag-start => {
                        root.drag-from = i;
                        root.drag-dy = 0px;
                    }
                    drag-move(dy) => { root.drag-dy = dy; }
                    drag-end => {
                        if (root.drag-from >= 0 && root.drag-to != root.drag-from) {
                            root.move-track(root.drag-from, root.drag-to);
                        }
                        root.drag-from = -1;
                        root.drag-dy = 0px;
                    }
                }
            }
            if root.state != LoadState.ready: StateMessage {
                width: parent.width;
                height: parent.height;
                state: root.state;
                empty-text: "No songs here yet";
            }
        }
    }
}
