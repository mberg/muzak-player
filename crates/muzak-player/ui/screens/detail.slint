import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { TileData, TrackData, LoadState } from "../types.slint";
import { IconButton } from "../components/icon_button.slint";
import { PillButton } from "../components/pill_button.slint";
import { TrackRow } from "../components/track_row.slint";
import { StateMessage } from "../components/state_message.slint";

// A small text button for the bar above the song list.
component BarButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> primary: false;
    in property <color> tint: Theme.text;
    callback clicked();
    height: 40px;
    width: row.preferred-width;
    border-radius: 20px;
    background: root.primary
        ? (touch.pressed ? Theme.accent.darker(0.15) : Theme.accent)
        : (touch.pressed ? Theme.surface-hi : Theme.surface);
    // Icon-only buttons are round.
    row := HorizontalLayout {
        padding-left: root.label == "" ? 10px : 14px;
        padding-right: root.label == "" ? 10px : 16px;
        spacing: 6px;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 20px;
                height: 20px;
                colorize: root.primary ? Theme.accent-text : root.tint;
            }
        }
        if root.label != "": Text {
            text: root.label;
            color: root.primary ? Theme.accent-text : root.tint;
            font-size: Theme.font-small;
            font-weight: 800;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component DetailScreen inherits Rectangle {
    in property <TileData> header;
    in property <[TrackData]> tracks;
    in property <LoadState> state;
    // The signed-in account owns this playlist.
    in property <bool> editable;
    in property <bool> editing;
    in property <bool> can-add;
    // "23 songs · 1 hr 12 min"
    in property <string> summary;
    // Albums: whether it's in the library, toggled by the heart.
    in property <bool> saveable;
    in property <bool> saved;
    callback toggle-save();
    callback back();
    callback play(bool);
    callback play-track(int);
    callback add(string);
    callback edit();
    callback finish-editing();
    callback rename();
    callback delete();
    callback remove(int);
    callback move-track(int, int);
    // Drag state: which row is held, and how far it has moved.
    property <int> drag-from: -1;
    property <length> drag-dy: 0px;
    property <int> drag-to: root.drag-from < 0 ? -1
        : Math.max(0, Math.min(root.tracks.length - 1, root.drag-from + Math.round(root.drag-dy / Theme.touch)));
    property <length> art: 196px;
    background: Theme.bg;
    HorizontalLayout {
        padding: 16px;
        padding-right: 8px;
        spacing: 20px;
        VerticalLayout {
            width: root.art;
            spacing: 10px;
            alignment: start;
            Rectangle {
                width: root.art;
                height: root.art;
                border-radius: Theme.radius;
                clip: true;
                background: Theme.surface;
                Image {
                    source: @image-url("../icons/note.svg");
                    width: 40%;
                    height: 40%;
                    colorize: Theme.text-dim;
                    visible: !root.header.has-image;
                }
                Image {
                    width: 100%;
                    height: 100%;
                    source: root.header.image;
                    image-fit: cover;
                    opacity: root.header.has-image ? 1 : 0;
                    animate opacity { duration: 200ms; }
                }
            }
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.header.title;
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 800;
                    wrap: word-wrap;
                    overflow: elide;
                    max-height: 52px;
                }
                Text {
                    text: root.header.subtitle;
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                    overflow: elide;
                    visible: root.header.subtitle != "";
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                PillButton {
                    label: "Play";
                    icon: @image-url("../icons/play.svg");
                    primary: true;
                    clicked => { root.play(false); }
                }
                IconButton {
                    icon: @image-url("../icons/shuffle.svg");
                    clicked => { root.play(true); }
                }
            }
        }
        VerticalLayout {
            spacing: 4px;
            // The bar above the songs: what's here, and editing for playlists you own.
            HorizontalLayout {
                height: 44px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.editing ? "Drag to reorder" : root.summary;
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.saveable: VerticalLayout {
                    alignment: center;
                    BarButton {
                        icon: root.saved ? @image-url("../icons/heart.svg") : @image-url("../icons/heart-outline.svg");
                        tint: root.saved ? Theme.accent : Theme.text;
                        clicked => { root.toggle-save(); }
                    }
                }
                if root.editable && !root.editing: VerticalLayout {
                    alignment: center;
                    BarButton {
                        icon: @image-url("../icons/edit.svg");
                        clicked => { root.edit(); }
                    }
                }
                if root.editing: VerticalLayout {
                    alignment: center;
                    BarButton {
                        label: "Rename";
                        clicked => { root.rename(); }
                    }
                }
                if root.editing: VerticalLayout {
                    alignment: center;
                    BarButton {
                        label: "Delete";
                        tint: Theme.danger;
                        clicked => { root.delete(); }
                    }
                }
                if root.editing: VerticalLayout {
                    alignment: center;
                    BarButton {
                        label: "Done";
                        primary: true;
                        clicked => { root.finish-editing(); }
                    }
                }
            }
            Rectangle {
                ListView {
                    for track[i] in root.tracks: Rectangle {
                        height: Theme.touch;
                        TrackRow {
                            // Room for the scrollbar so it doesn't cover the durations.
                            width: parent.width - 12px;
                            x: 0;
                            data: track;
                            editing: root.editing;
                            show-add: root.can-add;
                            drag-offset: i == root.drag-from ? root.drag-dy : 0px;
                            drop-marker: i != root.drag-to || i == root.drag-from ? 0 : (root.drag-to < root.drag-from ? 1 : 2);
                            clicked => { root.play-track(i); }
                            add => { root.add(track.uri); }
                            remove => { root.remove(i); }
                            drag-start => {
                                root.drag-from = i;
                                root.drag-dy = 0px;
                            }
                            drag-move(dy) => { root.drag-dy = dy; }
                            drag-end => {
                                if (root.drag-from >= 0 && root.drag-to != root.drag-from) {
                                    root.move-track(root.drag-from, root.drag-to);
                                }
                                root.drag-from = -1;
                                root.drag-dy = 0px;
                            }
                        }
                    }
                }
                if root.state != LoadState.ready: StateMessage {
                    width: parent.width;
                    height: parent.height;
                    state: root.state;
                    empty-text: "No songs here yet";
                }
            }
        }
    }
}
