import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SearchRowData, LoadState } from "../types.slint";
import { SearchRow } from "../components/search_row.slint";
import { StateMessage } from "../components/state_message.slint";

// Audiobooks: a filter field, Continue listening, then every book.
export component BooksScreen inherits Rectangle {
    in property <string> query;
    in property <bool> keyboard;
    in property <length> keyboard-height;
    in property <[SearchRowData]> rows;
    in property <LoadState> state;
    in property <string> message;
    callback open-book(string);
    callback open-keyboard();
    property <length> bar: 76px;
    background: Theme.bg;
    Rectangle {
        x: 16px;
        y: 12px;
        width: parent.width - 32px;
        height: 52px;
        border-radius: 26px;
        background: Theme.surface;
        border-width: root.keyboard ? 2px : 0px;
        border-color: Theme.accent;
        accessible-role: button;
        accessible-label: "Search books";
        accessible-action-default => { root.open-keyboard(); }
        TouchArea {
            clicked => { root.open-keyboard(); }
        }
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../icons/search.svg");
                    width: 24px;
                    height: 24px;
                    colorize: Theme.text-dim;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.query == "" ? "Search books, authors, narrators" : root.query;
                color: root.query == "" ? Theme.text-dim : Theme.text;
                font-size: Theme.font-body;
                font-weight: root.query == "" ? 400 : 800;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    Rectangle {
        x: 8px;
        y: root.bar;
        width: parent.width - 16px;
        height: parent.height - root.bar - (root.keyboard ? root.keyboard-height : 0px);
        ListView {
            for row in root.rows: SearchRow {
                data: row;
                clicked => { root.open-book(row.uri); }
            }
        }
        if root.state != LoadState.ready: StateMessage {
            width: parent.width;
            height: parent.height;
            state: root.state;
            empty-text: root.message != "" ? root.message : "No books found";
            failed-text: root.message != "" ? root.message : "Can't load books right now";
        }
    }
}
