import { Theme } from "../theme.slint";
import { SpeakerRowData } from "../types.slint";
import { IconButton } from "../components/icon_button.slint";

component Card inherits Rectangle {
    in property <string> title;
    border-radius: Theme.radius;
    background: Theme.surface;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Text {
            text: root.title;
            color: Theme.accent;
            font-size: Theme.font-small;
            font-weight: 800;
        }
        @children
    }
}

component SmallPill inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <color> tint: Theme.text;
    in property <bool> enabled: true;
    callback clicked();
    height: 44px;
    width: label-text.preferred-width + 36px;
    border-radius: 22px;
    opacity: root.enabled ? 1 : 0.4;
    background: root.primary
        ? (touch.pressed ? Theme.accent.darker(0.15) : Theme.accent)
        : (touch.pressed ? Theme.bg.brighter(0.2) : Theme.bg);
    label-text := Text {
        text: root.label;
        color: root.primary ? Theme.accent-text : root.tint;
        font-size: Theme.font-small;
        font-weight: 800;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component SpeakerRow inherits Rectangle {
    in property <SpeakerRowData> data;
    callback clicked();
    height: 56px;
    border-radius: 10px;
    background: touch.pressed ? Theme.surface-hi : Theme.bg;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../icons/speaker.svg");
                width: 24px;
                height: 24px;
                colorize: Theme.text-dim;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.data.name;
            color: Theme.text;
            font-size: Theme.font-body;
            font-weight: 800;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.data.status;
            color: root.data.status == "In use" ? Theme.accent : Theme.text-dim;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
    }
}

export component SettingsScreen inherits Rectangle {
    in property <string> account-name;
    in property <string> account-id;
    in property <string> device-name;
    in property <string> output;
    in property <bool> on-speaker;
    in property <bool> speaker-connected;
    in property <bool> bluetooth;
    in property <bool> scanning;
    in property <[SpeakerRowData]> speakers;
    in property <string> message;
    in property <string> bluetooth-note;
    in property <bool> restarting;
    callback rename-device();
    callback find-speakers();
    callback connect-speaker(string);
    callback use-jack();
    callback forget-speaker();
    background: Theme.bg;
    Flickable {
        content-height: column.preferred-height;
        column := VerticalLayout {
            width: root.width;
            padding: 16px;
            spacing: 14px;
            alignment: start;
            Text {
                text: "Settings";
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: 800;
            }
            Card {
                title: "Spotify account";
                Text {
                    text: root.account-name == "" ? "Not loaded yet" : root.account-name;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 800;
                    overflow: elide;
                }
                if root.account-id != "" && root.account-id != root.account-name: Text {
                    text: "Spotify ID " + root.account-id;
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                }
                Text {
                    text: "Sign-in is done from the Mac with muzak-setup.";
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
            }
            Card {
                title: "Device name";
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.device-name;
                        color: Theme.text;
                        font-size: Theme.font-body;
                        font-weight: 800;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    IconButton {
                        size: 48px;
                        icon: @image-url("../icons/edit.svg");
                        clicked => { root.rename-device(); }
                    }
                }
                Text {
                    text: "The name Spotify shows when you pick where to play.";
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
            }
            Card {
                title: "Speaker";
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../icons/speaker.svg");
                            width: 26px;
                            height: 26px;
                            colorize: Theme.text;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: root.output;
                            color: Theme.text;
                            font-size: Theme.font-body;
                            font-weight: 800;
                            overflow: elide;
                        }
                        if root.on-speaker: Text {
                            text: root.speaker-connected ? "Connected" : "Not connected";
                            color: root.speaker-connected ? Theme.accent : Theme.text-dim;
                            font-size: Theme.font-small;
                        }
                    }
                }
                if root.bluetooth: HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    SmallPill {
                        label: root.scanning ? "Looking…" : "Find speakers";
                        primary: true;
                        enabled: !root.scanning && !root.restarting;
                        clicked => { root.find-speakers(); }
                    }
                    if root.on-speaker: SmallPill {
                        label: "Use headphone jack";
                        enabled: !root.restarting;
                        clicked => { root.use-jack(); }
                    }
                    if root.on-speaker: SmallPill {
                        label: "Forget";
                        tint: Theme.danger;
                        enabled: !root.restarting;
                        clicked => { root.forget-speaker(); }
                    }
                }
                if !root.bluetooth: Text {
                    text: root.bluetooth-note;
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
                for speaker in root.speakers: SpeakerRow {
                    data: speaker;
                    clicked => { root.connect-speaker(speaker.address); }
                }
                if root.message != "": Text {
                    text: root.message;
                    color: root.restarting ? Theme.accent : Theme.text-dim;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
            }
        }
    }
}
