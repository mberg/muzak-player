import { Theme } from "../theme.slint";

component RailItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 84px;
    background: root.active ? Theme.surface-hi : transparent;
    Rectangle {
        x: 0;
        width: 5px;
        height: root.height * 0.6;
        border-radius: 3px;
        background: root.active ? Theme.accent : transparent;
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Image {
            source: root.icon;
            height: 34px;
            image-fit: contain;
            colorize: root.active ? Theme.accent : Theme.text-dim;
        }
        Text {
            text: root.label;
            horizontal-alignment: center;
            font-size: 13px;
            color: root.active ? Theme.text : Theme.text-dim;
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Index order matches Section::index in model.rs.
export component Rail inherits Rectangle {
    in property <int> selected;
    callback select(int);
    width: Theme.rail-width;
    background: Theme.surface;
    // Scrolls when the items don't fit the screen.
    Flickable {
        content-height: items.preferred-height;
        items := VerticalLayout {
            width: root.width;
            padding-top: 8px;
            padding-bottom: 8px;
            alignment: start;
            // Search first, above Playlists.
            RailItem { icon: @image-url("../icons/search.svg"); label: "Search"; active: root.selected == 4; clicked => { root.select(4); } }
            RailItem { icon: @image-url("../icons/playlists.svg"); label: "Playlists"; active: root.selected == 0; clicked => { root.select(0); } }
            RailItem { icon: @image-url("../icons/album.svg"); label: "Albums"; active: root.selected == 1; clicked => { root.select(1); } }
            RailItem { icon: @image-url("../icons/artist.svg"); label: "Artists"; active: root.selected == 2; clicked => { root.select(2); } }
            RailItem { icon: @image-url("../icons/heart.svg"); label: "Liked"; active: root.selected == 3; clicked => { root.select(3); } }
            RailItem { icon: @image-url("../icons/history.svg"); label: "Recent"; active: root.selected == 5; clicked => { root.select(5); } }
            // Settings: small, at the end of the list.
            Rectangle {
                height: 64px;
                Rectangle {
                    width: 56px;
                    height: 48px;
                    border-radius: 12px;
                    background: root.selected == 6 || gear-touch.pressed ? Theme.surface-hi : transparent;
                    Image {
                        source: @image-url("../icons/settings.svg");
                        width: 26px;
                        height: 26px;
                        colorize: root.selected == 6 ? Theme.accent : Theme.text-dim;
                    }
                    gear-touch := TouchArea {
                        clicked => { root.select(6); }
                    }
                }
            }
        }
    }
}
