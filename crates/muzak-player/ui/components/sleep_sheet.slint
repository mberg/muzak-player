import { Theme } from "../theme.slint";

component Choice inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    callback clicked();
    height: 72px;
    border-radius: 36px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    background: root.primary
        ? (touch.pressed ? Theme.accent.darker(0.15) : Theme.accent)
        : (touch.pressed ? Theme.surface-hi : Theme.bg);
    Text {
        text: root.label;
        color: root.primary ? Theme.accent-text : Theme.text;
        font-size: 22px;
        font-weight: 800;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Sleep timer: stop the music after 30 or 60 minutes.
export component SleepSheet inherits Rectangle {
    callback pick(int);
    callback close();
    background: #000000b0;
    TouchArea {
        clicked => { root.close(); }
    }
    Rectangle {
        width: 440px;
        height: col.preferred-height;
        border-radius: Theme.radius;
        background: Theme.surface;
        TouchArea {}
        col := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            Text {
                text: "Sleep timer";
                color: Theme.text;
                font-size: 24px;
                font-weight: 800;
            }
            Text {
                text: "Music fades out and stops. Tap the moon again to cancel.";
                color: Theme.text-dim;
                font-size: Theme.font-small;
            }
            Choice {
                label: "30 minutes";
                primary: true;
                clicked => { root.pick(30); }
            }
            Choice {
                label: "60 minutes";
                clicked => { root.pick(60); }
            }
        }
    }
}
